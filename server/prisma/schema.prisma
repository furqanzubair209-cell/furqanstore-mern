generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextIndex"]
}
datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  VENDOR
  CUSTOMER
}

enum UserStatus {
  ACTIVE
  PENDING
  SUSPENDED
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  PENDING
  OUT_OF_STOCK
}

enum ProductBadge {
  NONE
  NEW
  HOT
  SALE
  BEST
  LOW_STOCK
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  COD
  CARD
}

enum EarningStatus {
  PENDING
  COMPLETED
  CANCELLED
}

// One row per user. Vendor-specific fields are nullable on the same table
// (the original schema did this too) since a dedicated VendorProfile table
// added no real value at this scale, but store fields are namespaced.
model User {
  id            Int        @id @default(autoincrement())
  fullName      String
  email         String     @unique
  phone         String
  password      String
  role          Role       @default(CUSTOMER)
  status        UserStatus @default(PENDING)
  vendorName    String?
  vendorBio     String?    @db.Text
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  products      Product[]        @relation("VendorProducts")
  cartItems     CartItem[]
  orders        Order[]
  vendorItems   OrderItem[]      @relation("VendorOrderItems")
  refreshTokens RefreshToken[]
  notifications Notification[]
  addresses     Address[]
  wishlist      Wishlist[]
  commissionChanges CommissionSetting[] @relation("CommissionChangedBy")

  @@index([role])
  @@index([status])
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Address {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String   @default("Home")
  line1     String
  city      String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String
  slug      String    @unique
  icon      String?
  createdAt DateTime  @default(now())
  products  Product[]
}

model Product {
  id          Int           @id @default(autoincrement())
  name        String
  description String?       @db.Text
  price       Decimal       @db.Decimal(12, 2)
  stock       Int           @default(0)
  imageUrl    String?       @db.VarChar(500)
  categoryId  Int?
  category    Category?     @relation(fields: [categoryId], references: [id])
  vendorId    Int
  vendor      User          @relation("VendorProducts", fields: [vendorId], references: [id])
  rating      Decimal       @default(0) @db.Decimal(2, 1)
  reviews     Int           @default(0)
  badge       ProductBadge  @default(NONE)
  status      ProductStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  cartItems  CartItem[]
  orderItems OrderItem[]
  wishlistedBy Wishlist[]

  @@index([vendorId])
  @@index([categoryId])
  @@index([status])
  @@fulltext([name, description])
}

model CartItem {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int      @default(1)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
}

model Order {
  id              Int           @id @default(autoincrement())
  userId          Int
  user            User          @relation(fields: [userId], references: [id])
  subtotal        Decimal       @db.Decimal(12, 2)
  commissionTotal Decimal       @default(0) @db.Decimal(12, 2)
  total           Decimal       @db.Decimal(12, 2)
  status          OrderStatus   @default(PENDING)
  paymentMethod   PaymentMethod @default(COD)
  shippingAddress String        @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  items OrderItem[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

// Every commission-relevant figure is snapshotted here at order time.
// Changing CommissionSetting later never touches existing rows.
model OrderItem {
  id               Int           @id @default(autoincrement())
  orderId          Int
  order            Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId        Int
  product          Product       @relation(fields: [productId], references: [id])
  productName      String
  vendorId         Int
  vendor           User          @relation("VendorOrderItems", fields: [vendorId], references: [id])
  quantity         Int
  unitPrice        Decimal       @db.Decimal(12, 2)
  grossAmount      Decimal       @db.Decimal(12, 2)
  commissionRate   Decimal       @db.Decimal(5, 2)
  commissionAmount Decimal       @db.Decimal(12, 2)
  vendorEarning    Decimal       @db.Decimal(12, 2)
  earningStatus    EarningStatus @default(PENDING)
  createdAt        DateTime      @default(now())

  @@index([orderId])
  @@index([vendorId])
  @@index([productId])
  @@index([earningStatus])
}

// Only one row should be active at a time; history is kept for audit and
// so admin can see when rates changed. Order items always store their own
// copy of the rate, so this table is never read retroactively.
model CommissionSetting {
  id            Int      @id @default(autoincrement())
  rate          Decimal  @db.Decimal(5, 2)
  active        Boolean  @default(true)
  effectiveFrom DateTime @default(now())
  changedById   Int?
  changedBy     User?    @relation("CommissionChangedBy", fields: [changedById], references: [id])
  createdAt     DateTime @default(now())

  @@index([active])
}

model ContactMessage {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  subject   String?
  message   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Wishlist {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
}
